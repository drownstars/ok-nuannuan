* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.vbs text eol=crlf
.gitmodules text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.png binary
*.ico binary
*.onnx binary
*.TTF binary
